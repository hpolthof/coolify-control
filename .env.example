# Server and network configuration
# PORT - Server port (default: 8080)
PORT=8080

# HOST - Server bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Data and web directories
# DATA_DIR - Directory for SQLite database and state (default: ./data outside Docker;
# the Docker image sets this to /data itself, see Dockerfile)
# DATA_DIR=./data   (leave unset in Docker: the image uses /data, which is the persistent volume)

# WEB_DIR - Path to built frontend (served statically, default: built web/dist)
# Usually not needed; set if serving from a different location
# WEB_DIR=/app/web

# Logging
# LOG_LEVEL - Pino log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# Proxy and cookies
# TRUST_PROXY - Number of reverse proxy hops in front of this server, used to resolve the
# real client IP (req.ip) from X-Forwarded-For/X-Forwarded-Proto (default: 1, i.e. one
# reverse proxy such as Coolify's Traefik). Set to "false" to trust no proxy and always use
# the direct socket address.
TRUST_PROXY=1

# COOKIE_SECURE - Cookie security: auto (secure if HTTPS), true, or false (default: auto)
COOKIE_SECURE=auto

# Session configuration
# SESSION_TTL_HOURS - Session validity in hours (default: 336, i.e. 14 days)
SESSION_TTL_HOURS=336

# Initial admin user (required at first startup)
# ADMIN_USERNAME - Admin username to create on first run
ADMIN_USERNAME=admin

# ADMIN_PASSWORD - Admin password to create on first run (use a strong password)
ADMIN_PASSWORD=changeme

# Coolify API (required)
# COOLIFY_URL - Coolify URL without trailing slash and without /api (e.g., https://coolify.example.com)
COOLIFY_URL=https://coolify.example.com

# COOLIFY_TOKEN - Coolify API token (Coolify → Keys & Tokens → API tokens)
# Required permissions: read + deploy
# Note: read:sensitive is NOT required (and recommended to NOT enable)
COOLIFY_TOKEN=

# Connector configuration
# CONNECTOR_IMAGE - Docker image reference for the connector container
# Publish by the GitHub workflow to ghcr.io; default: ghcr.io/hpolthof/coolify-control-connector:latest
CONNECTOR_IMAGE=ghcr.io/hpolthof/coolify-control-connector:latest

# CONNECTOR_KEYS_DIR - Host path of Coolify's key directory on the Coolify host
# The connector runs on the Coolify host with this mounted read-only (default: /data/coolify/ssh/keys)
CONNECTOR_KEYS_DIR=/data/coolify/ssh/keys

# Polling and history
# POLL_INTERVAL_MS - Metrics collection interval (minimum 5000 ms, default: 15000)
POLL_INTERVAL_MS=15000

# COOLIFY_POLL_INTERVAL_MS - Inventory update interval from Coolify API (minimum 5000 ms, default: 30000)
COOLIFY_POLL_INTERVAL_MS=30000

# HISTORY_DAYS - Retention period for detailed metrics in SQLite (default: 7)
HISTORY_DAYS=7

# RAW_RETENTION_HOURS - Retention period for raw high-resolution metrics before aggregation (default: 24)
RAW_RETENTION_HOURS=24
